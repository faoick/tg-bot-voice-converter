# Получите токен у https://t.me/BotFather через /newbot.
BOT_TOKEN=

# Если ffmpeg/ffprobe доступны в PATH, оставьте эти строки без изменений.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Необязательно: ограничьте доступ своими Telegram ID через запятую.
# Узнать свой ID можно командой /id в боте.
ALLOWED_USER_IDS=
